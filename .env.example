# Environment variables for the ANICET FARMS LIMITED website.
#
# Both variables are PUBLIC and are inlined into the client bundle.
# Never place secrets in variables prefixed with PUBLIC_.

# Optional: real backend endpoint (e.g. a Formspree/Netlify Forms URL or your own API).
# When empty, the contact form performs strict client-side validation and then
# falls back to composing the user's message in their email client (mailto:).
PUBLIC_CONTACT_FORM_ENDPOINT=

# Fallback destination email used by the mailto fallback above.
# TODO: Replace with ANICET FARMS LIMITED's verified contact email.
PUBLIC_CONTACT_EMAIL=