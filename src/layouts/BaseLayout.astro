---
// Base layout wrapping every page. Contains the global <head> SEO, skips links,
// header, main content slot, and footer. Font imports are handled by the global
// CSS file; this layout adds the interactive scripts.

import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloating from '../components/WhatsAppFloating.astro';
import BottomNav from '../components/BottomNav.astro';

import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  path?: string;
  ogImage?: string;
  schema?: string;
  /** Page class applied to the <body> (useful for dark-body pages). */
  bodyClass?: string;
}

const {
  title,
  description,
  path = '/',
  ogImage,
  schema,
  bodyClass,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Apply the saved/system theme before anything paints (prevents a flash
         of the wrong theme on load). -->
    <script is:inline>
      (() => {
        const KEY = 'anicet-theme';
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        let theme = prefersDark ? 'dark' : 'light';
        try {
          const stored = localStorage.getItem(KEY);
          if (stored === 'light' || stored === 'dark') theme = stored;
        } catch {
          theme = prefersDark ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <Seo title={title} description={description} path={path} ogImage={ogImage} schema={schema} />
  </head>
  <body class:list={[bodyClass]}>
    <a class="skip-link" href="#main">Skip to main content</a>

    <Header currentPath={path} />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <!-- Dismissible storefront banner (mobile only), fixed above the bottom nav -->
    <div class="info-banner" data-info-banner>
      <p class="info-banner__row">
        <span class="info-banner__icon" aria-hidden="true">i</span>
        <span class="info-banner__text">Fresh vegetable online!</span>
      </p>
      <button class="info-banner__dismiss" type="button" data-info-dismiss>
        Dismiss
      </button>
    </div>

    <BottomNav currentPath={path} />

    <WhatsAppFloating />

    <script>
      import { initNav, initMobileSearchOverlay, initInfoBanner } from '../scripts/nav';
      import { initReveal } from '../scripts/reveal';
      import { initThemeToggle } from '../scripts/theme';

      initNav();
      initMobileSearchOverlay();
      initInfoBanner();
      initReveal();
      initThemeToggle();
    </script>
  </body>
</html>