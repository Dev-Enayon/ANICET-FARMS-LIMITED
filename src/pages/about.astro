---
// About — a professional agricultural/export overview.
// All copy is positioning language grounded in the existing project (company.ts,
// services.ts). No invented history, statistics, certifications, destinations,
// or team members. Aspirational vision/mission is labelled as direction.

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Reveal from '../components/Reveal.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import { company, about, businessAreas, values } from '../data/company';

const whoWeAreNote =
  'ANICET FARMS brings together agricultural production, sourcing and export-oriented supply. Our purpose is to help quality goods move from their source to the customers and markets that need them — reliably and to a consistent standard.';

const approachSteps = [
  {
    num: '01',
    title: 'Source',
    description: 'Sourcing quality produce and goods from farms and reliable suppliers.',
  },
  {
    num: '02',
    title: 'Select',
    description: 'Assessing goods against the quality and market requirements we serve.',
  },
  {
    num: '03',
    title: 'Prepare',
    description: 'Careful handling, preparation and packaging for dependable supply.',
  },
  {
    num: '04',
    title: 'Connect',
    description: 'Matching quality goods with customers, partners and appropriate markets.',
  },
  {
    num: '05',
    title: 'Export',
    description: 'Supporting the movement of goods to markets and clients beyond borders.',
  },
];

const partnershipGroups = [
  'Farmers',
  'Suppliers',
  'Customers',
  'Logistics partners',
  'Business partners',
  'Communities',
  'Markets',
];
---

<BaseLayout
  title="About ANICET FARMS"
  description="ANICET FARMS is an agricultural and export-focused company connecting quality farm produce and carefully sourced goods with markets that value reliability, quality and consistency."
  path="/about/"
>
  <PageHero
    eyebrow="About ANICET FARMS"
    title="Connecting Agriculture, Quality and Global Opportunity."
    lede={`${company.operatingName} is an agricultural and export-focused company working across farming, sourcing and the responsible movement of quality goods to market. ${about.bridge}`}
  >
    <Breadcrumbs slot="breadcrumbs" items={[{ name: 'About' }]} />
    <span class="chip chip--on-dark">Agricultural &amp; export</span>
    <span class="chip chip--on-dark">Quality-first</span>
    <span class="chip chip--on-dark">Partnership-ready</span>
  </PageHero>

  <!-- Who We Are -->
  <section class="section">
    <div class="container">
      <div class="split-grid">
        <SectionHeading
          eyebrow="Who We Are"
          title="Agriculture, sourcing and the movement of goods to markets."
          lede={about.intro}
        >
          <Reveal delay={80}>
            <p class="lede" style="margin-top:1.25rem">{whoWeAreNote}</p>
          </Reveal>
          <Reveal delay={120}>
            <p class="lede" style="margin-top:1rem;font-size:var(--text-sm);color:var(--color-muted)">
              The company's official profile is being formalised; verified details will replace
              this overview as they are confirmed.
            </p>
          </Reveal>
        </SectionHeading>
        <Reveal delay={140}>
          <figure class="photo-frame">
            <img
              src="/img/hero/hero-farm.jpeg"
              alt="Agricultural farmland landscape"
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- What We Do -->
  <section class="section section--tight band band--sand">
    <div class="container">
      <SectionHeading
        eyebrow="What We Do"
        title="Areas of focus."
        lede="Five areas define how ANICET FARMS intends to serve agriculture and trade. Each is described as a focus — exact product specifications are published on the Products page as they are confirmed."
      />
      <div class="grid-3">
        {
          businessAreas.map((area, index) => (
            <Reveal delay={index * 60}>
              <article class="feature-card">
                {area.image ? (
                  <figure class="feature-card__media">
                    <img
                      src={area.image}
                      alt={area.alt ?? area.title}
                      width="1280"
                      height="720"
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>
                ) : (
                  <div class="feature-card__media feature-card__media--mark" aria-hidden="true">
                    <span>◫</span>
                  </div>
                )}
                <div class="feature-card__body">
                  <h3>{area.title}</h3>
                  <p>{area.summary}</p>
                </div>
              </article>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- From Source to Market -->
  <section class="band band--dark section">
    <div class="container">
      <SectionHeading
        eyebrow="Our Approach"
        title="From Source to Market."
        lede="Our approach is centred on sourcing quality goods, preparing them carefully and connecting them with appropriate markets — locally and internationally. The stages below describe how we intend to work and will be refined as operations are confirmed."
        dark
      />
      <div class="chain about-chain">
        {
          approachSteps.map((step, index) => (
            <div class="chain__node" data-reveal style={`--reveal-delay: ${index * 60}ms`}>
              <span class="chain__num">{step.num}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
              <span class="chip chip--on-dark">Working approach</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why Quality Matters -->
  <section class="section">
    <div class="container">
      <div class="split-grid split-grid--reverse">
        <SectionHeading
          eyebrow="Why Quality Matters"
          title="Quality Is More Than a Standard."
          lede="Quality affects trust, repeat business and export relationships. It begins with the source and continues through handling, preparation and delivery — it is the thread that holds long-term supply relationships together."
        >
          <Reveal delay={80}>
            <p class="lede" style="margin-top:1.25rem">{about.qualityStatement}</p>
          </Reveal>
        </SectionHeading>
        <Reveal delay={140}>
          <figure class="photo-frame">
            <img
              src="/img/farming/farming-operation.jpg"
              alt="Agricultural machinery operating in a farm field"
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- Vision & Mission -->
  <section class="section section--tight band band--sand">
    <div class="container">
      <SectionHeading
        eyebrow="Purpose"
        title="Our Vision and Mission."
        lede="Presented as direction. Both statements will be aligned to the company's official wording and verified record once confirmed."
      />
      <div class="grid-2">
        <Reveal>
          <article class="card">
            <span class="chip chip--accent">Our Vision</span>
            <p class="display-3" style="margin-top:1rem">{about.visionDirection}</p>
          </article>
        </Reveal>
        <Reveal delay={100}>
          <article class="card">
            <span class="chip chip--accent">Our Mission</span>
            <p class="display-3" style="margin-top:1rem">{about.missionDirection}</p>
          </article>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Our Values"
        title="The standards we hold ourselves to."
        lede="Working definitions — to be refined with the company before launch."
      />
      <div class="grid-4">
        {
          values.map((value, index) => (
            <Reveal delay={index * 60}>
              <article class="card">
                <span class="card__index">{String(index + 1).padStart(2, '0')}</span>
                <h3>{value.title}</h3>
                <p>{value.description}</p>
              </article>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- People, Partnerships and Opportunity -->
  <section class="band band--dark section">
    <div class="container">
      <SectionHeading
        eyebrow="Partnerships"
        title="People, Partnerships and Opportunity."
        lede={about.relationshipsStatement}
        dark
      >
        <Reveal delay={80}>
          <p class="text-on-dark-dim" style="margin-top:1rem">
            We are building a business that operates best in relationship with the people around it —
            from the farm gate to the final market. No current partnerships are claimed here; these
            are the relationships a business like ours is built on.
          </p>
        </Reveal>
      </SectionHeading>
      <Reveal>
        <div class="chips-wrap">
          {
            partnershipGroups.map((group) => (
              <span class="chip chip--on-dark">{group}</span>
            ))
          }
        </div>
      </Reveal>
    </div>
  </section>

  <!-- Export positioning -->
  <section class="section">
    <div class="container">
      <div class="split-grid split-grid--reverse">
        <SectionHeading
          eyebrow="Export Mindset"
          title="From Local Value to Wider Markets."
          lede="Agricultural products and quality goods can create value far beyond their point of production when they are properly sourced, handled and connected with appropriate markets. ANICET FARMS aims to participate in that value chain — supporting the movement of quality goods across borders."
        />
        <Reveal delay={140}>
          <figure class="photo-frame">
            <img
              src="/img/farming/harvesting.jpeg"
              alt="Harvested crops gathered from the farm"
              width="1280"
              height="853"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </Reveal>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Get In Touch"
    title="Talk to the team about agriculture, sourcing or export."
    lede="Send an enquiry about products, partnerships or operations — the right person will respond."
    actions={[
      { label: 'Contact us on WhatsApp', variant: 'accent', whatsapp: true },
      { label: 'What We Do', href: '/what-we-do/', variant: 'ghost-dark' },
      { label: 'Products', href: '/products/', variant: 'ghost-dark' },
    ]}
  />
</BaseLayout>

<style>
  /* Five equal process steps — horizontal on desktop, stacked on mobile.
     Higher specificity than the global .chain rules so it wins cleanly. */
  .chain.about-chain {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  @media (max-width: 1200px) {
    .chain.about-chain {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .chain.about-chain {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .chain.about-chain {
      grid-template-columns: 1fr;
    }
  }

  .feature-card__media--mark {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-background-alt);
    color: var(--color-muted);
    font-size: 1.75rem;
  }

  .chips-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
</style>