---
// Impact — reporting areas + metric registry. Zero invented statistics:
// registry communicates what WILL be reported; values only show when
// confirmed in data.

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Reveal from '../components/Reveal.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import { reportAreas, metricRegistry, statistics } from '../data/impact';
---

<BaseLayout
  title="Impact"
  description="ANICET FARMS LIMITED impact reporting — published only with verified figures."
  path="/impact/"
>
  <PageHero
    eyebrow="Impact"
    title="Measured responsibility."
    lede="We will report our impact on the figures that matter — and, importantly, only publish numbers once they are verified. No estimates. No dressing."
  >
    <Breadcrumbs slot="breadcrumbs" items={[{ name: 'Impact' }]} />
    <span class="chip chip--on-dark">Verified-only reporting</span>
  </PageHero>

  <!-- Verified headline stats (only when confirmed) -->
  {
    statistics.length > 0 && (
      <section class="section section--tight band band--dark">
        <div class="container">
          <div class="stat-grid">
            {
              statistics.map((stat) => (
                <div class="stat" data-reveal>
                  <p class="stat__value">
                    {stat.prefix}{stat.value}{stat.suffix}
                  </p>
                  <p class="stat__label">{stat.label}</p>
                  {stat.note && <p class="stat__note">{stat.note}</p>}
                </div>
              ))
            }
          </div>
        </div>
      </section>
    )
  }

  <!-- Reporting areas -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="What We Report"
        title="Four areas of accountable impact."
        lede="Each area below represents a commitment to transparent, verified reporting as data becomes available."
      />
      <div class="grid-2">
        {
          reportAreas.map((area, i) => (
            <Reveal delay={(i % 2) * 80}>
              <article class="card">
                <span class="card__index">{String(i + 1).padStart(2, '0')}</span>
                <h3>{area.title}</h3>
                <p>{area.description}</p>
              </article>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Metric registry -->
  <section class="section section--tight band band--sand">
    <div class="container">
      <SectionHeading
        eyebrow="Metric Registry"
        title="The numbers we will publish."
        lede="This is the agreed register of metrics ANICET FARMS LIMITED intends to track and publish. Values appear here only with their confirmation."
        align="center"
      />
      <div class="registry">
        {
          metricRegistry.map((metric) => (
            <div class="registry__row" data-reveal>
              <div>
                <h3>{metric.label}</h3>
                {metric.definition && <p>{metric.definition}</p>}
              </div>
              <span class="chip chip--accent">Awaiting verified value</span>
              <!-- TODO: show metric.value + units once confirmed in src/data/impact.ts -->
            </div>
          ))
        }
      </div>
      <Reveal>
        <div class="empty-state" style="margin-top:2rem">
          <h3>Verified headline figures will appear at the top of this page.</h3>
          <p>
            Until ANICET FARMS LIMITED provides confirmed figures, the page deliberately
            shows no numbers. {/* TODO: populate `statistics` in src/data/impact.ts */}
          </p>
        </div>
      </Reveal>
    </div>
  </section>

  <CtaBand
    eyebrow="Partnership"
    title="Measure impact alongside us."
    lede="Find out more about our reporting commitments over a direct conversation."
    actions={[
      { label: 'Ask about impact', variant: 'accent', whatsapp: true },
      { label: 'About', href: '/about/', variant: 'ghost-dark' },
    ]}
  />
</BaseLayout>