---
// Admin dashboard — sign in with the shared password, then view catalogue
// stats and add / update / delete products. Edits are written to
// data/products.json and are reflected immediately on the home and Products
// pages (both render on demand). This page is intentionally NOT linked from
// the public site and is excluded from the sitemap.

export const prerender = false;

import '../styles/global.css';
import {
  readAdminCookie,
  verifySessionToken,
  isUsingDevCredentials,
} from '../lib/auth';
import {
  getCatalog,
  getStoreUpdatedAt,
  categoryDefinitions,
  availabilityOptions,
} from '../lib/catalog';
import type { ProductCategory } from '../data/products';

const sessionToken = readAdminCookie(Astro.request);
const authed = verifySessionToken(sessionToken);
const devCredentials = isUsingDevCredentials();

let catalog: ProductCategory[] = [];
let updatedAt: Date | null = null;
if (authed) {
  catalog = getCatalog();
  updatedAt = getStoreUpdatedAt();
}

const totals = {
  products: catalog.reduce((sum, category) => sum + category.products.length, 0),
  inStock: 0,
  request: 0,
  unconfirmed: 0,
};
for (const category of catalog) {
  for (const product of category.products) {
    if (product.availability === 'in-stock') totals.inStock += 1;
    else if (product.availability === 'request-information') totals.request += 1;
    else totals.unconfirmed += 1;
  }
}

const badge = (availability: string | undefined): string =>
  availability === 'in-stock'
    ? 'admin-badge admin-badge--stock'
    : availability === 'request-information'
      ? 'admin-badge admin-badge--request'
      : 'admin-badge admin-badge--unconfirmed';

const availabilityLabel = (availability: string | undefined): string =>
  availability === 'in-stock'
    ? 'In stock'
    : availability === 'request-information'
      ? 'Request information'
      : 'Pending specification';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin · ANICET FARMS</title>
  </head>
  <body class="admin-body">
    {!authed ? (
      <main class="admin-login">
        <form class="admin-login__card" data-login-form novalidate>
          <div class="admin-login__mark">
            <span class="admin-login__monogram">A</span>
            <span>
              <strong>ANICET FARMS</strong>
              <small>Product administration</small>
            </span>
          </div>
          <div>
            <h1>Sign in</h1>
            <p class="admin-login__hint">
              Enter the admin password to manage the product catalogue.
            </p>
          </div>
          <label class="admin-field">
            <span class="admin-field__label">Password</span>
            <input
              class="admin-input"
              type="password"
              name="password"
              autocomplete="current-password"
              autofocus
              required
            />
          </label>
          <p class="admin-login__error" data-login-error hidden></p>
          <button class="admin-btn admin-btn--primary" type="submit">Sign in</button>
          {devCredentials && (
            <p class="admin-login__dev">
              No ADMIN_PASSWORD set — dev fallback password is in use. Configure
              <code>ADMIN_PASSWORD</code> and <code>ADMIN_AUTH_SECRET</code> for real use.
            </p>
          )}
        </form>
      </main>
    ) : (
      <div class="admin-shell">
        <header class="admin-topbar">
          <a class="admin-topbar__brand" href="/admin/">
            <span class="admin-login__monogram">A</span>
            <span>
              <strong>ANICET FARMS</strong>
              <small>Admin</small>
            </span>
          </a>
          <nav class="admin-topbar__nav" aria-label="Admin navigation">
            <a href="/products/" target="_blank" rel="noreferrer">View site</a>
            <button class="admin-link" type="button" data-logout>Sign out</button>
          </nav>
        </header>

        <main class="admin-main">
          <div class="admin-head">
            <div>
              <h1 class="admin-title">Dashboard</h1>
              {updatedAt && (
                <p class="admin-muted">Catalogue last updated {updatedAt.toISOString()}</p>
              )}
            </div>
            <button class="admin-btn admin-btn--primary" type="button" data-add-product>
              + New product
            </button>
          </div>

          <section class="admin-stats">
            <div class="admin-stat">
              <span class="admin-stat__value">{totals.products}</span>
              <span class="admin-stat__label">Products</span>
            </div>
            {catalog.map((category) => (
              <div class="admin-stat">
                <span class="admin-stat__value">{category.products.length}</span>
                <span class="admin-stat__label">{category.name}</span>
              </div>
            ))}
            <div class="admin-stat">
              <span class="admin-stat__value">{totals.request}</span>
              <span class="admin-stat__label">Request information</span>
            </div>
            <div class="admin-stat">
              <span class="admin-stat__value">{totals.inStock}</span>
              <span class="admin-stat__label">In stock</span>
            </div>
            <div class="admin-stat">
              <span class="admin-stat__value">{totals.unconfirmed}</span>
              <span class="admin-stat__label">Unconfirmed</span>
            </div>
          </section>

          <section class="admin-card">
            <h2 class="admin-card__title">Products</h2>
            {catalog.flatMap((category) => category.products).length === 0 ? (
              <p class="admin-muted">No products yet — add the first one.</p>
            ) : (
              <div class="admin-table-wrap">
                <table class="admin-table">
                  <thead>
                    <tr>
                      <th scope="col">Product</th>
                      <th scope="col">Category</th>
                      <th scope="col">Availability</th>
                      <th scope="col"><span class="sr-only">Actions</span></th>
                    </tr>
                  </thead>
                  <tbody>
                    {
                      catalog.flatMap((category) =>
                        category.products.map((product) => (
                          <tr
                            class="admin-row"
                            data-id={product.id}
                            data-name={product.name}
                            data-category={product.category}
                            data-availability={product.availability ?? 'unconfirmed'}
                            data-description={product.description}
                            data-unit={product.unit ?? ''}
                            data-packaging={product.packaging ?? ''}
                            data-image={product.image ?? ''}
                            data-image-alt={product.imageAlt ?? ''}
                            data-image-width={product.imageWidth ?? ''}
                            data-image-height={product.imageHeight ?? ''}
                          >
                            <td>
                              <div class="admin-product">
                                {product.image ? (
                                  <img
                                    class="admin-thumb"
                                    src={product.image}
                                    alt={product.imageAlt ?? product.name}
                                    width="56"
                                    height="56"
                                    loading="lazy"
                                  />
                                ) : (
                                  <span class="admin-thumb admin-thumb--empty" aria-hidden="true"></span>
                                )}
                                <div class="admin-product__meta">
                                  <strong class="admin-product__name">{product.name}</strong>
                                  <span class="admin-product__id">{product.id}</span>
                                </div>
                              </div>
                            </td>
                            <td>{product.category}</td>
                            <td>
                              <span class={badge(product.availability)}>
                                {availabilityLabel(product.availability)}
                              </span>
                            </td>
                            <td class="admin-actions">
                              <button class="admin-btn admin-btn--ghost" type="button" data-edit>
                                Edit
                              </button>
                              <button class="admin-btn admin-btn--danger" type="button" data-delete>
                                Delete
                              </button>
                            </td>
                          </tr>
                        )),
                      )
                    }
                  </tbody>
                </table>
              </div>
            )}
          </section>
        </main>

        <div class="admin-panel" data-product-panel hidden>
          <form class="admin-panel__card" data-product-form novalidate>
            <div class="admin-panel__head">
              <h2 class="admin-title" data-form-title>New product</h2>
              <button class="admin-panel__close" type="button" data-form-cancel aria-label="Close">×</button>
            </div>
            <input type="hidden" name="id" />
            <div class="admin-grid">
              <label class="admin-field">
                <span class="admin-field__label">Name *</span>
                <input class="admin-input" type="text" name="name" required maxlength="140" />
              </label>
              <label class="admin-field">
                <span class="admin-field__label">Category *</span>
                <select class="admin-input" name="category" required>
                  {categoryDefinitions.map((category) => (
                    <option value={category.name}>{category.name}</option>
                  ))}
                </select>
              </label>
              <label class="admin-field admin-field--wide">
                <span class="admin-field__label">Description *</span>
                <textarea class="admin-input" name="description" rows="3" required maxlength="600"></textarea>
              </label>
              <label class="admin-field">
                <span class="admin-field__label">Availability</span>
                <select class="admin-input" name="availability">
                  {availabilityOptions.map((option) => (
                    <option value={option}>{availabilityLabel(option)}</option>
                  ))}
                </select>
              </label>
              <label class="admin-field">
                <span class="admin-field__label">Unit</span>
                <input class="admin-input" type="text" name="unit" maxlength="80" placeholder="e.g. per 100 g" />
              </label>
              <label class="admin-field">
                <span class="admin-field__label">Packaging</span>
                <input class="admin-input" type="text" name="packaging" maxlength="80" placeholder="e.g. woven sack" />
              </label>
              <label class="admin-field admin-field--wide">
                <span class="admin-field__label">
                  Image path <span class="admin-muted">(must exist under public/, e.g. /img/products/x.png)</span>
                </span>
                <input class="admin-input" type="text" name="image" placeholder="/img/products/…" />
              </label>
              <label class="admin-field admin-field--wide">
                <span class="admin-field__label">Image alt text</span>
                <input class="admin-input" type="text" name="imageAlt" maxlength="300" />
              </label>
              <label class="admin-field">
                <span class="admin-field__label">Image width (px)</span>
                <input class="admin-input" type="number" name="imageWidth" min="1" max="10000" />
              </label>
              <label class="admin-field">
                <span class="admin-field__label">Image height (px)</span>
                <input class="admin-input" type="number" name="imageHeight" min="1" max="10000" />
              </label>
            </div>
            <p class="admin-form-error" data-form-error hidden></p>
            <div class="admin-panel__actions">
              <button class="admin-btn admin-btn--ghost" type="button" data-form-cancel>Cancel</button>
              <button class="admin-btn admin-btn--primary" type="submit" data-form-submit>Save product</button>
            </div>
          </form>
        </div>

        <div class="admin-toast" data-toast hidden></div>
      </div>
    )}

    <script is:inline>
      (() => {
        if (document.querySelector('[data-login-form]')) {
          const loginForm = document.querySelector('[data-login-form]');
          const errorEl = document.querySelector('[data-login-error]');
          loginForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            const password = new FormData(loginForm).get('password');
            errorEl.hidden = true;
            loginForm.querySelector('[type="submit"]').disabled = true;
            try {
              const response = await fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ password }),
              });
              const data = await response.json();
              if (!response.ok) throw new Error(data && data.message ? data.message : 'Sign in failed.');
              window.location.reload();
            } catch (error) {
              errorEl.textContent = error instanceof Error ? error.message : 'Sign in failed.';
              errorEl.hidden = false;
              loginForm.querySelector('[type="submit"]').disabled = false;
            }
          });
        }

        const panel = document.querySelector('[data-product-panel]');
        const form = document.querySelector('[data-product-form]');
        if (panel && form) {
          const title = document.querySelector('[data-form-title]');
          const errorEl = document.querySelector('[data-form-error]');
          const toast = document.querySelector('[data-toast]');
          let editingId = null;

          const showToast = (message) => {
            toast.textContent = message;
            toast.hidden = false;
            clearTimeout(showToast._timer);
            showToast._timer = setTimeout(() => {
              toast.hidden = true;
            }, 4000);
          };

          const setMessage = (message) => {
            errorEl.textContent = message;
            errorEl.hidden = false;
          };

          const fill = (values) => {
            for (const [name, value] of Object.entries(values)) {
              const field = form.elements.namedItem(name);
              if (field) field.value = value == null ? '' : String(value);
            }
          };

          const open = (values, id) => {
            editingId = id;
            fill(values);
            title.textContent = id ? 'Edit product' : 'New product';
            errorEl.hidden = true;
            panel.hidden = false;
            form.elements.namedItem('name').focus();
          };

          document.querySelectorAll('[data-edit]').forEach((button) => {
            button.addEventListener('click', () => {
              const row = button.closest('tr');
              open(
                {
                  name: row.dataset.name,
                  category: row.dataset.category,
                  availability: row.dataset.availability,
                  description: row.dataset.description,
                  unit: row.dataset.unit,
                  packaging: row.dataset.packaging,
                  image: row.dataset.image,
                  imageAlt: row.dataset.imageAlt,
                  imageWidth: row.dataset.imageWidth,
                  imageHeight: row.dataset.imageHeight,
                },
                row.dataset.id,
              );
            });
          });

          document.querySelector('[data-add-product]').addEventListener('click', () => open({
            category: form.elements.namedItem('category').options[0].value,
            availability: 'request-information',
          }, null));

          const close = () => {
            panel.hidden = true;
            editingId = null;
          };
          form.querySelectorAll('[data-form-cancel]').forEach((button) => button.addEventListener('click', close));

          form.addEventListener('submit', async (event) => {
            event.preventDefault();
            const submitButton = form.querySelector('[data-form-submit]');
            submitButton.disabled = true;
            const payload = Object.fromEntries(new FormData(form).entries());
            delete payload.id;
            errorEl.hidden = true;
            try {
              const response = await fetch(
                editingId ? `/api/products/${encodeURIComponent(editingId)}` : '/api/products',
                {
                  method: editingId ? 'PUT' : 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(payload),
                },
              );
              const data = await response.json();
              if (!response.ok) {
                if (data.details && Array.isArray(data.details)) {
                  setMessage(data.details.map((d) => `${d.field}: ${d.message}`).join(' · '));
                } else {
                  setMessage(data.message || 'Save failed.');
                }
                submitButton.disabled = false;
                return;
              }
              showToast(editingId ? 'Product updated.' : 'Product added.');
              close();
              window.setTimeout(() => window.location.reload(), 350);
            } catch {
              setMessage('Network error — could not save.');
              submitButton.disabled = false;
            }
          });

          document.querySelectorAll('[data-delete]').forEach((button) => {
            button.addEventListener('click', async () => {
              const row = button.closest('tr');
              if (!window.confirm(`Delete "${row.dataset.name}"? This removes it from the catalogue and public site.`)) return;
              button.disabled = true;
              try {
                const response = await fetch(`/api/products/${encodeURIComponent(row.dataset.id)}`, {
                  method: 'DELETE',
                });
                if (!response.ok) {
                  const data = await response.json();
                  showToast(data.message || 'Delete failed.');
                  button.disabled = false;
                  return;
                }
                showToast('Product deleted.');
                window.setTimeout(() => window.location.reload(), 350);
              } catch {
                showToast('Network error — could not delete.');
                button.disabled = false;
              }
            });
          });
        }

        const logoutButton = document.querySelector('[data-logout]');
        if (logoutButton) {
          logoutButton.addEventListener('click', async () => {
            try {
              await fetch('/api/auth/logout', { method: 'POST' });
            } catch {
              // Best-effort: navigate regardless of the network result.
            }
            window.location.href = '/admin/';
          });
        }
      })();
    </script>

    <style is:global>
      .admin-body {
        margin: 0;
        background: var(--color-background);
        color: var(--color-text);
        font-family:
          'Inter Variable',
          system-ui,
          -apple-system,
          sans-serif;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }
      .admin-login {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 1.25rem;
      }
      .admin-login__card {
        width: 100%;
        max-width: 24rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: 1.75rem;
        display: grid;
        gap: 1.1rem;
        box-shadow: 0 18px 40px rgba(33, 29, 23, 0.08);
      }
      .admin-login__mark,
      .admin-topbar__brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: var(--color-text);
        text-decoration: none;
      }
      .admin-login__monogram {
        display: grid;
        place-items: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 0.75rem;
        background: var(--color-primary);
        color: var(--color-on-dark);
        font-family: var(--font-display);
        font-size: 1.15rem;
        flex: none;
      }
      .admin-login__mark small,
      .admin-topbar__brand small {
        display: block;
        color: var(--color-muted);
        font-size: 0.8rem;
      }
      .admin-login__card h1,
      .admin-title {
        font-family: var(--font-display);
        margin: 0;
      }
      .admin-login__hint,
      .admin-muted {
        color: var(--color-muted);
        margin: 0;
        font-size: 0.92rem;
      }
      .admin-field {
        display: grid;
        gap: 0.35rem;
      }
      .admin-field__label {
        font-size: 0.85rem;
        font-weight: 650;
        color: var(--color-text);
      }
      .admin-input {
        width: 100%;
        box-sizing: border-box;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        background: var(--color-surface);
        color: var(--color-text);
        padding: 0.6rem 0.75rem;
        font: inherit;
        font-size: 0.95rem;
      }
      .admin-input:focus {
        outline: 2px solid var(--color-accent);
        outline-offset: 1px;
        border-color: transparent;
      }
      .admin-btn {
        border: 1px solid transparent;
        border-radius: var(--radius-sm);
        padding: 0.6rem 1rem;
        font: inherit;
        font-weight: 650;
        cursor: pointer;
        transition: background-color var(--duration) ease, border-color var(--duration) ease;
      }
      .admin-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }
      .admin-btn--primary {
        background: var(--color-primary);
        color: var(--color-on-dark);
      }
      .admin-btn--primary:hover {
        background: var(--color-primary-soft);
      }
      .admin-btn--ghost {
        background: transparent;
        border-color: var(--color-border);
        color: var(--color-text);
      }
      .admin-btn--ghost:hover {
        border-color: var(--color-muted);
      }
      .admin-btn--danger {
        background: transparent;
        border-color: #d39a90;
        color: #a1441f;
      }
      .admin-btn--danger:hover {
        background: #fbe9e3;
      }
      .admin-login__error {
        margin: 0;
        color: #a1441f;
        font-size: 0.9rem;
      }
      .admin-login__dev {
        margin: 0;
        font-size: 0.78rem;
        color: var(--color-muted);
        border-top: 1px solid var(--color-border);
        padding-top: 0.9rem;
      }
      .admin-login__dev code {
        font-size: 0.75rem;
      }

      .admin-shell {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      .admin-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.8rem 1.25rem;
        background: var(--color-primary);
        color: var(--color-on-dark);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      .admin-topbar__brand {
        color: var(--color-on-dark);
      }
      .admin-topbar__brand small {
        color: var(--color-on-dark-dim);
      }
      .admin-topbar__nav {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        font-size: 0.92rem;
      }
      .admin-topbar__nav a {
        color: var(--color-on-dark);
        text-decoration: none;
      }
      .admin-topbar__nav a:hover {
        text-decoration: underline;
      }
      .admin-link {
        background: none;
        border: 0;
        padding: 0;
        color: var(--color-on-dark-dim);
        font: inherit;
        cursor: pointer;
      }
      .admin-link:hover {
        color: var(--color-on-dark);
        text-decoration: underline;
      }
      .admin-main {
        width: 100%;
        max-width: 72rem;
        margin: 0 auto;
        padding: 1.75rem 1.25rem 3rem;
        box-sizing: border-box;
      }
      .admin-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.25rem;
      }
      .admin-head .admin-title {
        font-size: 1.6rem;
      }
      .admin-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
        gap: 0.85rem;
        margin-bottom: 1.5rem;
      }
      .admin-stat {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        padding: 1rem 1.1rem;
        display: grid;
        gap: 0.2rem;
      }
      .admin-stat__value {
        font-family: var(--font-display);
        font-size: 1.7rem;
        color: var(--color-accent);
      }
      .admin-stat__label {
        font-size: 0.85rem;
        color: var(--color-muted);
      }
      .admin-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        padding: 1.25rem;
      }
      .admin-card__title {
        font-family: var(--font-display);
        margin: 0 0 0.9rem;
      }
      .admin-table-wrap {
        overflow-x: auto;
      }
      .admin-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.92rem;
      }
      .admin-table th {
        text-align: left;
        color: var(--color-muted);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 0.5rem 0.6rem;
        border-bottom: 1px solid var(--color-border);
      }
      .admin-table td {
        padding: 0.7rem 0.6rem;
        border-bottom: 1px solid var(--color-border);
        vertical-align: middle;
      }
      .admin-table tbody tr:last-child td {
        border-bottom: 0;
      }
      .admin-product {
        display: flex;
        align-items: center;
        gap: 0.8rem;
      }
      .admin-thumb {
        width: 56px;
        height: 56px;
        object-fit: contain;
        border-radius: var(--radius-sm);
        background: var(--color-background-alt);
        border: 1px solid var(--color-border);
        flex: none;
      }
      .admin-thumb--empty {
        display: block;
