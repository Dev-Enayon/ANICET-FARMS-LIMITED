---
// Products — premium agricultural / export catalogue, enquiry-first.
// Renders purely from productCategories (src/data/products.ts). Each
// collection renders as one full-width category card — nothing is invented,
// and collections still being prepared simply show no product entries.

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Reveal from '../components/Reveal.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import ProductCategoryCard from '../components/ProductCategoryCard.astro';
import { productCategories } from '../data/products';

const sourcingPrinciples = [
  {
    step: 'Source',
    description:
      'Product sourcing and agricultural production form the start of every collection. Verified sourcing relationships are documented here as they are confirmed.',
  },
  {
    step: 'Quality',
    description:
      'Careful attention to handling, preparation and presentation at every stage — the basis of dependable supply for quality-focused customers and markets.',
  },
  {
    step: 'Enquiry',
    description:
      'Every entry is enquiry-first. Request information for the verified details you need, and the team responds directly.',
  },
];
---

<BaseLayout
  title="Products"
  description="ANICET FARMS product catalogue — enquiry-first collections across vegetables, meat, farming and export-oriented goods, built with verified entries and a straightforward request path."
  path="/products/"
>
  <PageHero
    eyebrow="Products · ANICET FARMS"
    title="Products That Connect Agriculture With Opportunity."
    lede="ANICET FARMS presents its collections as an export-aware catalogue: real products are listed the moment they are verified, and each entry carries a straightforward path to request information. Collections still being prepared state this openly."
  >
    <Breadcrumbs slot="breadcrumbs" items={[{ name: 'Products' }]} />
    <span class="chip chip--on-dark">Enquiry-first</span>
    <span class="chip chip--on-dark">Four collections</span>
    <span class="chip chip--on-dark">Export-oriented</span>
  </PageHero>

  <!-- Category navigation -->
  <section class="section section--tight">
    <div class="container">
      <Reveal>
        <nav class="cat-nav" aria-label="Product categories">
          {productCategories.map((category, index) => (
            <a href={`#product-${category.id}`}>
              <span class="cat-nav__num">{String(index + 1).padStart(2, '0')}</span>
              {category.name}
            </a>
          ))}
        </nav>
      </Reveal>
    </div>
  </section>

  <!-- Category shelves: header row (heading + divider) above each collection.
       Every collection renders as one full-width category card — there is no
       product carousel to page through. -->
  {
    productCategories.map((category, index) => (
      <section
        id={`product-${category.id}`}
        class:list={['cat', 'section', index % 2 === 1 && 'band band--sand section--tight']}
      >
        <div class="container">
          <Reveal>
            <header class="shelf-head">
              <SectionHeading
                eyebrow={`Collection ${String(index + 1).padStart(2, '0')}`}
                title={category.name}
                lede={category.summary}
              />
            </header>
            <div class="shelf-head__rule" aria-hidden="true"></div>
          </Reveal>

          <Reveal class="cat-full">
            <ProductCategoryCard
              category={category}
              index={index + 1}
              full
              exploreHref={`#product-${category.id}`}
            />
          </Reveal>
        </div>
      </section>
    ))
  }

  <!-- Sourcing / quality / enquiry -->
  <section class="section band band--sand">
    <div class="container">
      <SectionHeading
        eyebrow="Source · Quality · Enquiry"
        title="How the catalogue stays dependable."
        lede="Three working principles shape every collection — presented honestly, with verified detail added as operations are confirmed."
      />
      <div class="grid-3">
        {
          sourcingPrinciples.map((principle, index) => (
            <Reveal delay={index * 70}>
              <article class="card">
                <span class="card__index">{String(index + 1).padStart(2, '0')}</span>
                <h3>{principle.step}</h3>
                <p>{principle.description}</p>
              </article>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Request Information"
    title="Building the catalogue, one collection at a time."
    lede="Send an enquiry about any product or collection — the team will respond with the verified details you need."
    actions={[
      { label: 'Request information', variant: 'accent', whatsapp: true },
      { label: 'What We Do', href: '/what-we-do/', variant: 'ghost-dark' },
      { label: 'About us', href: '/about/', variant: 'ghost-dark' },
    ]}
  />
</BaseLayout>

<style>
  .cat {
    scroll-margin-top: 6rem;
  }

  /* Full-width collection: the category card fills the section container
     (no product carousel beside it). Keep the same vertical rhythm as the
     two-column shelf so alignment with neighbouring sections holds. */
  .cat-full {
    display: block;
  }

  @media (min-width: 1024px) {
    .cat-full {
      margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
    }
  }

  .cat-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .cat-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: 650;
    text-decoration: none;
    transition:
      background-color var(--duration) ease,
      border-color var(--duration) ease,
      color var(--duration) ease;
  }

  .cat-nav a:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-dark);
  }

  .cat-nav__num {
    font-family: var(--font-display);
    color: var(--color-accent);
  }
</style>