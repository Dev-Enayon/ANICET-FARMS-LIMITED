---
// Products — enquiry-first catalogue. Products render only from verified data.
// Until then: an honest empty state plus the catalogue anatomy.

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Reveal from '../components/Reveal.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EmptyState from '../components/EmptyState.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CtaBand from '../components/CtaBand.astro';
import { products, catalogueNote } from '../data/products';
---

<BaseLayout
  title="Products"
  description="ANICET FARMS LIMITED product catalogue — built enquiry-first with request information."
  path="/products/"
>
  <PageHero
    eyebrow="Products"
    title="Enquiry-first product information."
    lede={catalogueNote}
  >
    <Breadcrumbs slot="breadcrumbs" items={[{ name: 'Products' }]} />
    <span class="chip chip--on-dark">No e-commerce</span>
    <span class="chip chip--on-dark">Request-based</span>
  </PageHero>

  <!-- Catalogue -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Catalogue"
        title="What we will offer."
        lede="Products are listed only when specifications have been verified. This page is structured so a full catalogue can publish the moment the data arrives."
      />
      {
        products.length > 0 ? (
          <div class="grid-3">
            {
              products.map((product) => (
                <article class="card">
                  <span class="chip chip--accent">
                    {product.availability === 'in-stock'
                      ? 'Available'
                      : product.availability === 'request-information'
                        ? 'Request information'
                        : 'Pending specification'}
                  </span>
                  <h3>{product.name}</h3>
                  <p>{product.description}</p>
                  <WhatsAppButton label="Request information" variant="ghost" size="sm" />
                </article>
              ))
            }
          </div>
        ) : (
          <Reveal>
            <EmptyState
              title="The catalogue will be published once specifications are confirmed."
              note="No product or specification claims are made until verified. When confirmed, each entry will display name, category, and unit details — always with a straightforward path to request information."
            >
              <!-- Catalogue anatomy preview (decorative, labelled as a structure slot) -->
              <div class="grid-3" style="margin-top:1.5rem">
                {[0, 1, 2].map((_) => (
                  <div class="empty-state" aria-hidden="true" style="padding:1.5rem">
                    <div class="empty-state__mark" aria-hidden="true">◫</div>
                    <h3 style="font-size:1.05rem">Product listing</h3>
                    <p style="margin:0">
                      Confirmed specifications, category, and unit details appear here.
                    </p>
                  </div>
                ))}
              </div>
            </EmptyState>
          </Reveal>
        )
      }
    </div>
  </section>

  <!-- Sourcing principles -->
  <section class="section section--tight band band--sand">
    <div class="container">
      <SectionHeading
        eyebrow="Sourcing"
        title="Where our products come from."
        lede="Verified sourcing and production relationships will be documented here when confirmed."
      />
      <Reveal>
        <div class="empty-state">
          <h3>Sourcing transparency, once confirmed.</h3>
          <p>
            We intend to be clear about origin, handling, and production at every step. This
            section will carry those verified details as they become available.
            <!-- TODO: populate src/data/products.ts with verified product + sourcing data. -->
          </p>
        </div>
      </Reveal>
    </div>
  </section>

  <CtaBand
    eyebrow="Request Information"
    title="Interested in our product range?"
    lede="Send an enquiry and the team will respond with verified details."
    actions={[
      { label: 'Request information', variant: 'accent', whatsapp: true },
      { label: 'What We Do', href: '/what-we-do/', variant: 'ghost-dark' },
    ]}
  />
</BaseLayout>