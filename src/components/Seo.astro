---
import { company } from '../data/company';
import { siteUrl, defaultOgImage, defaultOgImageAlt } from '../data/site';

interface Props {
  title: string;
  description?: string;
  path?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Optional extra JSON-LD block as a serialised string. */
  schema?: string;
}

const {
  title,
  description = company.shortStatement,
  path = '/',
  ogImage = defaultOgImage,
  noindex = false,
  schema,
} = Astro.props;

const canonical = new URL(path, siteUrl).toString();
const imageUrl = new URL(ogImage, siteUrl).toString();
const ogAlt = ogImage === defaultOgImage ? defaultOgImageAlt : `ANICET FARMS LIMITED`;
const pageTitle = title === company.operatingName ? title : `${title} — ${company.operatingName}`;

// Only verified facts are emitted into structured data.
const orgaSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.legalName,
  url: siteUrl,
  logo: new URL('/img/logo.png', siteUrl).toString(),
});
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#24211b" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={company.legalName} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script is:inline type="application/ld+json" set:html={orgaSchema}></script>
{schema && <script is:inline type="application/ld+json" set:html={schema}></script>}