---
// Mobile-only storefront features (max-width: 767px). A featured "Fresh
// Products" block (green citrus line icon over a soft mint blob) with the
// helper feature items below in a 2-column grid. Hidden on desktop — the
// existing homepage sections are untouched.

const features = [
  {
    title: 'Affordability',
    caption: 'Sensible prices on every order',
    id: 'affordability',
  },
  {
    title: 'Customer Care',
    caption: 'Friendly help at every step',
    id: 'care',
  },
  {
    title: 'Fast Shipping',
    caption: 'Careful, prompt delivery',
    id: 'shipping',
  },
];
---

<section class="mobile-features" aria-label="Why shop with us">
  <div class="mobile-features__lead">
    <span class="mobile-features__icon" aria-hidden="true">
      <svg
        viewBox="0 0 48 48"
        width="40"
        height="40"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="24" cy="25" r="13" />
        <path d="M24 12c-4.5-2.5-8-2-8-2s1.5 3.5 0 6c1.5 2.5 1.5 2.5 1.5 2.5" />
        <path d="M27 12.5 33.5 6.5M33.5 6.5l1 4.4.8-8" />
        <circle cx="18.5" cy="27.5" r="1.6" />
      </svg>
    </span>
    <h2 class="mobile-features__heading">Fresh Products</h2>
  </div>

  <ul class="mobile-features__grid">
    {
      features.map((feature) => (
        <li class="mobile-features__item">
          <span class="mobile-features__item-icon" aria-hidden="true">
            {feature.id === 'affordability' && (
              <svg
                viewBox="0 0 24 24"
                width="28"
                height="28"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="8.5" />
                <path d="M14.5 8.5a3.2 3.2 0 1 0 0 7.7M12 6.5v11M9.5 9.5v5" />
                <path d="M12 2.5 9.3 5.2M12 2.5l2.7 2.7" />
              </svg>
            )}
            {feature.id === 'care' && (
              <svg
                viewBox="0 0 24 24"
                width="28"
                height="28"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 11a7 7 0 0 1 14 0v4.5a2 2 0 0 1-2 2h-1v-4h3" />
                <path d="M5 13.5v-4h3M5 11a7 7 0 0 1 14 0" />
                <path d="M3.5 18.5c1.4 1.6 5 2.5 8.5 2.5s7.1-.9 8.5-2.5" />
              </svg>
            )}
            {feature.id === 'shipping' && (
              <svg
                viewBox="0 0 24 24"
                width="28"
                height="28"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 6.5h10v9H3zM13 9.5h3.5l2.5 3V15.5H13" />
                <circle cx="6.5" cy="16.5" r="1.5" />
                <circle cx="16.5" cy="16.5" r="1.5" />
              </svg>
            )}
          </span>
          <h3 class="mobile-features__title">{feature.title}</h3>
          <p class="mobile-features__caption">{feature.caption}</p>
        </li>
      ))
    }
  </ul>
</section>