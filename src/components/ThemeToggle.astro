---
// Compact light/dark mode switch — a single control, not two buttons.
//
// The thumb position, the lit icon (sun in light, moon in dark), and the
// aria-checked state all communicate the current theme, so the state is never
// conveyed by colour alone. Behaviour lives in src/scripts/theme.ts (injected
// once via BaseLayout so multiple instances stay in sync).
//
// Layout: the moon sits on the left, the sun on the right. In light mode the
// thumb rests on the left (over the moon) and the sun is revealed; in dark mode
// the thumb slides right (over the sun) and the moon is revealed.

interface Props {
  /** Control variant: 'header' lives in the main header, 'menu' in the
      mobile navigation dialog. */
  placement?: 'header' | 'menu';
}

const { placement = 'header' } = Astro.props;
---

<button
  type="button"
  class:list={['theme-toggle', `theme-toggle--${placement}`]}
  role="switch"
  aria-checked="false"
  aria-label="Switch to dark mode"
  data-theme-toggle
>
  <span class="theme-toggle__track" aria-hidden="true">
    <svg
      class="theme-toggle__moon"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      focusable="false"
    >
      <path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z" />
    </svg>
    <svg
      class="theme-toggle__sun"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      focusable="false"
    >
      <circle cx="12" cy="12" r="4.2" />
      <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5 5l1.6 1.6M17.4 17.4L19 19M19 5l-1.6 1.6M6.6 17.4L5 19" />
    </svg>
    <span class="theme-toggle__thumb" aria-hidden="true"></span>
  </span>
</button>

<style>
  .theme-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 5.25rem; /* 84px */
    height: 2.75rem; /* 44px — comfortable touch target */
    padding: 0;
    background: var(--color-background-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition:
      background-color var(--duration) ease,
      border-color var(--duration) ease;
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible {
    border-color: var(--color-accent);
  }

  .theme-toggle[aria-checked='true'] {
    background: var(--color-primary-soft);
  }

  .theme-toggle__track {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .theme-toggle__moon,
  .theme-toggle__sun {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    transition:
      opacity var(--duration) ease,
      color var(--duration) ease;
  }

  /* Moon on the left, sun on the right. */
  .theme-toggle__moon {
    left: 0.4rem;
    color: var(--color-on-dark-dim);
    opacity: 0.45;
  }

  .theme-toggle__sun {
    right: 0.4rem;
    color: var(--color-accent);
    opacity: 1;
  }

  /* Dark mode: thumb rests over the sun; the moon lights up. */
  [data-theme='dark'] .theme-toggle__moon {
    color: var(--color-accent-soft);
    opacity: 1;
  }
  [data-theme='dark'] .theme-toggle__sun {
    color: var(--color-on-dark-dim);
    opacity: 0.4;
  }

  .theme-toggle__thumb {
    position: absolute;
    top: 0.4rem;
    left: 0.375rem;
    width: 1.75rem; /* 28px */
    height: calc(2.75rem - 0.8rem);
    background: var(--color-accent);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-sm);
    transition: transform calc(var(--duration) * 2) var(--ease-out);
    will-change: transform;
  }

  /* Travel: 84px wide − 28px thumb − 2 × 6px inset ≈ 44px. */
  [data-theme='dark'] .theme-toggle__thumb {
    transform: translateX(2.75rem);
  }
</style>