---
// Mobile-only hero carousel (max-width: 767px). Uses the same two owner-supplied
// hero photographs as the desktop hero, driven by the shared fade carousel
// (autoplay, Previous/Next, indicators, swipe, reduced-motion) with a compact
// brand/CTA overlay. Hidden above the mobile breakpoint.

import { company } from '../data/company';

const slides = [
  {
    src: '/img/hero/hero-vegetables.jpeg',
    width: 1280,
    height: 720,
    alt: 'Fresh green vegetables growing in an agricultural field',
  },
  {
    src: '/img/hero/hero-meat-seafood.jpeg',
    width: 1280,
    height: 720,
    alt: 'Fresh meat, seafood, poultry and eggs',
  },
];
---

<section
  class="mobile-hero"
  data-hero-slider
  data-hero-carousel
  aria-label="Featured imagery of fresh produce"
>
  <div class="mobile-hero__frame" data-hero-slides>
    {
      slides.map((slide, index) => (
        <figure
          class="mobile-hero__slide"
          data-hero-slide
          style={`opacity:${index === 0 ? 1 : 0}`}
          aria-hidden={index !== 0 ? 'true' : undefined}
        >
          <img
            class="mobile-hero__img"
            src={slide.src}
            alt={slide.alt}
            width={slide.width}
            height={slide.height}
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : undefined}
            decoding="async"
          />
        </figure>
      ))
    }
    <div class="mobile-hero__loader" data-hero-loader aria-hidden="true">
      <span class="mobile-hero__spinner"></span>
    </div>
    <div class="mobile-hero__content">
      <p class="mobile-hero__eyebrow">{company.legalName}</p>
      <h2 class="mobile-hero__title">
        Building better agriculture for a&nbsp;stronger future.
      </h2>
      <p class="mobile-hero__lede">{company.shortStatement}</p>
      <div class="mobile-hero__cta">
        <a class="btn btn--accent" href="/products/">Explore Products</a>
      </div>
    </div>
  </div>
  <div class="mobile-hero__controls">
    <button
      class="mobile-hero__nav mobile-hero__nav--prev"
      type="button"
      data-hero-prev
      aria-label="Previous hero image"
    >
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" focusable="false"><path d="M13 5l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <div class="mobile-hero__dots" data-hero-dots role="group" aria-label="Choose hero image">
      {
        slides.map((_, index) => (
          <button
            class="mobile-hero__dot"
            type="button"
            data-hero-dot
            aria-label={`Show hero image ${index + 1} of ${slides.length}`}
            aria-current={index === 0 ? 'true' : undefined}
          ></button>
        ))
      }
    </div>
    <button
      class="mobile-hero__nav mobile-hero__nav--next"
      type="button"
      data-hero-next
      aria-label="Next hero image"
    >
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" focusable="false"><path d="M9 5l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
</section>

<script>
  import { initHeroCarousel } from '../scripts/heroCarousel';
  const slider = document.querySelector<HTMLElement>('[data-hero-slider]');
  if (slider) {
    initHeroCarousel(slider);
    // Hide the loading spinner once the first image (or a fallback timeout) is
    // ready, revealing the slider over the warm-gray loading surface.
    const reveal = () => slider.classList.add('is-loaded');
    const first = slider.querySelector<HTMLImageElement>('[data-hero-slide] img');
    if (first?.complete) reveal();
    else first?.addEventListener('load', reveal, { once: true });
    window.setTimeout(reveal, 2500);
  }
</script>