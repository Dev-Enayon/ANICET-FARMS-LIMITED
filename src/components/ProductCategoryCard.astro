---
// Large visual category card. A full-bleed photograph (or an honest texture
// when the category has no owner-supplied image) with a gradient scrim, the
// category name in display type, a short summary and an "Explore Collection"
// affordance. `dense` produces the compact grid variant used on the homepage.

import type { ProductCategory } from '../data/products';

interface Props {
  category: ProductCategory;
  /** Where "Explore Collection" points (defaults to the in-page carousel anchor). */
  exploreHref?: string;
  dense?: boolean;
  /** Shelf variant: stretches to the adjacent product carousel row on desktop. */
  shelf?: boolean;
  /** Ordinal for the "Collection N" eyebrow (optional). */
  index?: number;
}

const { category, exploreHref = `#product-${category.id}-carousel`, dense = false, shelf = false, index } = Astro.props;
---

<a
  class:list={['catcard', dense && 'catcard--dense', shelf && 'catcard--shelf']}
  href={exploreHref}
  aria-label={`Explore the ${category.name} collection`}
>
  {category.cardImage ? (
    <img
      class="catcard__photo"
      src={category.cardImage}
      alt={category.cardImageAlt ?? category.name}
      width={1280}
      height={853}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <span class="catcard__photo catcard__photo--texture" aria-hidden="true">
      <span class="catcard__mark">◫</span>
    </span>
  )}

  <span class="catcard__scrim" aria-hidden="true"></span>

  <span class="catcard__body">
    {index !== undefined && <span class="catcard__kicker">Collection {String(index).padStart(2, '0')}</span>}
    <span class="catcard__title">{category.name}</span>
    <span class="catcard__desc">{category.summary}</span>
    <span class="catcard__link">
      Explore Collection
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </span>
</a>

<style>
  .catcard {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-lg);
    aspect-ratio: 1 / 1.05;
    color: var(--color-on-dark);
    text-decoration: none;
    isolation: isolate;
    box-shadow: var(--shadow-md);
  }

  .catcard__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 600ms var(--ease-out);
    will-change: transform;
  }

  .catcard:hover .catcard__photo {
    transform: scale(1.03);
  }

  .catcard__photo--texture {
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      repeating-linear-gradient(45deg, transparent 0 12px, rgb(244 240 230 / 0.045) 12px 24px),
      linear-gradient(160deg, var(--color-primary-soft), var(--color-primary));
  }

  .catcard__mark {
    font-size: 3rem;
    color: rgb(244 240 230 / 0.35);
  }

  .catcard__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(36 33 27 / 0.92) 0%, rgb(36 33 27 / 0.45) 45%, rgb(36 33 27 / 0.08) 75%);
    z-index: 1;
    transition: opacity var(--duration) ease;
  }

  .catcard__body {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    padding: clamp(1.25rem, 2.5vw, 2rem);
  }

  .catcard__kicker {
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-soft);
  }

  .catcard__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2.2rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .catcard__desc {
    color: var(--color-on-dark-dim);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    max-width: 34ch;
  }

  .catcard__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--color-on-dark);
    margin-top: 0.4rem;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--color-accent);
  }

  .catcard:hover .catcard__link {
    color: var(--color-accent-soft);
  }

  @media (max-width: 1100px) {
    .catcard {
      aspect-ratio: 16 / 9;
    }
  }

  /* Shelf variant: fill the row height beside the product carousel so the
     card and product shelf read as one unit. Only on desktop. */
  @media (min-width: 1024px) {
    .catcard--shelf {
      aspect-ratio: auto;
      height: 100%;
      min-height: 20rem;
    }

    .catcard--shelf .catcard__title {
      font-size: clamp(1.35rem, 1.6vw, 1.85rem);
    }

    .catcard--shelf .catcard__desc {
      font-size: var(--text-xs);
    }
  }

  @media (max-width: 767px) {
    .catcard {
      aspect-ratio: 16 / 9;
    }
    .catcard__desc {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
</style>