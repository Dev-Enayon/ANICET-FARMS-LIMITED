---
// Product carousel — horizontal, snap-scrolled collection with Prev/Next
// controls, a live "n / total" counter, keyboard arrow support on the track
// and native touch scrolling. Multiple products per view on desktop, a single
// primary product per view on mobile. Behaviour lives in
// src/scripts/productCarousel.ts.

import ProductCard from './ProductCard.astro';
import type { ProductCategory } from '../data/products';

interface Props {
  category: ProductCategory;
}

const { category } = Astro.props;
const list = category.products;
---

<div class="pcarousel" data-product-carousel aria-label={`${category.name} product carousel`}>
  <div class="pcarousel__bar">
    <p class="pcarousel__count" data-product-count aria-live="polite">1 / {list.length}</p>
    <div class="pcarousel__nav">
      <button
        class="pcarousel__btn"
        type="button"
        data-product-prev
        aria-label={`Previous ${category.name} product`}
      >
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
          <path d="M11 4l-5 5 5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button
        class="pcarousel__btn"
        type="button"
        data-product-next
        aria-label={`Next ${category.name} product`}
      >
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
          <path d="M7 4l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>

  <div
    class="pcarousel__track"
    data-product-track
    role="region"
    tabindex="0"
    aria-label={`Browse ${category.name} products — use arrow keys`}
  >
    {list.map((product, index) => (
      <ProductCard product={product} index={index} />
    ))}
  </div>
</div>

<style>
  .pcarousel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .pcarousel__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .pcarousel__count {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
    color: var(--color-muted);
  }

  .pcarousel__nav {
    display: flex;
    gap: 0.5rem;
  }

  .pcarousel__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
    transition:
      background-color var(--duration) ease,
      border-color var(--duration) ease,
      color var(--duration) ease,
      opacity var(--duration) ease;
  }

  .pcarousel__btn:hover:not(:disabled) {
    background: var(--color-primary);
    color: var(--color-on-dark);
    border-color: var(--color-primary);
  }

  .pcarousel__btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .pcarousel__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 2.5rem) / 3);
    gap: 1.25rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 0.25rem;
    scroll-margin-inline: 1rem;
    outline-offset: 4px;
  }

  .pcarousel__track::-webkit-scrollbar {
    display: none;
  }

  .pcarousel__track :global([data-product-slide]) {
    scroll-snap-align: start;
  }

  @media (max-width: 1100px) {
    .pcarousel__track {
      grid-auto-columns: calc((100% - 1.25rem) / 2);
    }
  }

  @media (max-width: 767px) {
    .pcarousel__track {
      grid-auto-columns: 100%;
    }
  }
</style>