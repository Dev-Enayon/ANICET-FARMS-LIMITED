---
// Single product card inside a product carousel. Product name sits above the
// image (so viewers always know which product is shown), followed by a short
// overview, an availability chip and an enquiry-first WhatsApp CTA. Clicking
// the photograph opens the shared lightbox (see productCarousel.ts).

import type { Product } from '../data/types';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  product: Product;
  index: number;
}

const { product, index } = Astro.props;

const availabilityLabel =
  product.availability === 'in-stock'
    ? 'Available'
    : product.availability === 'request-information'
      ? 'Request information'
      : 'Pending specification';

const handle = `product-${product.id}`;
---

<article
  class="pcard"
  data-product-slide
  id={handle}
  data-image-src={product.image}
  data-image-alt={product.imageAlt ?? `Photograph of ${product.name}`}
  data-image-name={product.name}
  data-image-description={product.description}
>
  <div class="pcard__top">
    <span class="pcard__index">{String(index + 1).padStart(2, '0')}</span>
    <h3 class="pcard__name">{product.name}</h3>
  </div>

  {product.image ? (
    <button
      type="button"
      class="pcard__media"
      data-lightbox-open
      aria-label={`Open full-screen image of ${product.name}`}
    >
      <img
        src={product.image}
        alt={product.imageAlt ?? `Photograph of ${product.name}`}
        width={product.imageWidth ?? 1200}
        height={product.imageHeight ?? 800}
        loading="lazy"
        decoding="async"
      />
      <span class="pcard__zoom" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 18 18" focusable="false">
          <path d="M2 8h14M8 2v14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </span>
    </button>
  ) : (
    <div class="pcard__media pcard__media--missing" aria-hidden="true">
      <span>◫</span>
    </div>
  )}

  <div class="pcard__body">
    <p class="pcard__desc">{product.description}</p>
    <div class="pcard__row">
      <span class="chip chip--accent">{availabilityLabel}</span>
      <WhatsAppButton
        label="Request information"
        variant="ghost"
        size="sm"
        message={`Hello ANICET FARMS LIMITED, I am interested in ${product.name}.`}
      />
    </div>
  </div>
</article>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--duration) ease,
      box-shadow var(--duration) ease,
      border-color var(--duration) ease;
    min-width: 0;
  }

  .pcard:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: rgb(192 85 44 / 0.45);
  }

  .pcard__top {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 1.1rem 1.25rem 0.4rem;
  }

  .pcard__index {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-accent);
    letter-spacing: 0.12em;
  }

  .pcard__name {
    font-size: var(--text-xl);
    line-height: 1.2;
    margin: 0;
  }

  .pcard__media {
    position: relative;
    display: block;
    width: 100%;
    margin: 0.9rem 0 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .pcard__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }

  .pcard:hover .pcard__media img {
    transform: scale(1.04);
  }

  .pcard__zoom {
    position: absolute;
    inset-inline-end: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-pill);
    background: rgb(36 33 27 / 0.55);
    color: var(--color-on-dark);
    opacity: 0;
    transition: opacity var(--duration) ease;
    backdrop-filter: blur(4px);
  }

  .pcard:hover .pcard__zoom,
  .pcard__media:focus-visible .pcard__zoom {
    opacity: 1;
  }

  .pcard__media--missing {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-background-alt);
    color: var(--color-muted);
    font-size: 1.75rem;
  }

  .pcard__body {
    padding: 1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    flex: 1;
  }

  .pcard__desc {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .pcard__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: auto;
  }

  /* Desktop only: catalogue-shelf card — image on top (1:1 photo well with
     object-fit contain so the whole product stays visible), name below. */
  @media (min-width: 1024px) {
    .pcard__media {
      order: -1;
      margin: 0;
      aspect-ratio: 1 / 1;
      background: var(--color-background-alt);
    }

    .pcard__media img {
      object-fit: contain;
      padding: 0.75rem;
    }

    .pcard__top {
      padding-top: 1.1rem;
    }

    .pcard__body {
      padding-top: 0.9rem;
    }
  }
</style>